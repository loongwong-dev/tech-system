  "query": "\n        SELECT t.id, t.name, m.role\n        FROM memberships m\n        JOIN tenants t ON t.id = m.tenant_id\n        WHERE m.user_id = $1 AND t.status = 'active'\n        ORDER BY m.created_at, t.id\n        ",
