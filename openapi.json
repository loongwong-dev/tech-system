    "/api/v1/lessons": {
      "get": {
        "tags": [
          "lessons"
        ],
        "summary": "按日期范围列出当前租户课次，使用游标分页。",
        "operationId": "listLessons",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "起始日期（含），YYYY-MM-DD",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "结束日期（含），YYYY-MM-DD",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页数量，默认 20，上限 100",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "上一页返回的 nextCursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "课次列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonListResponse"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "日期、分页或游标非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "sid": []
          }
        ]
      },
      "post": {
        "tags": [
          "lessons"
        ],
        "summary": "创建课次；班级必须属于当前租户。",
