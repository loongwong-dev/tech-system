        "responses": {
          "201": {
            "description": "注册成功并建立会话",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "409": {
            "description": "邮箱已存在或邀请码无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/auth/tenant": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "校验 membership 后切换租户并轮换会话。",
        "operationId": "switchTenant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TenantSwitchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "租户已切换并轮换会话"
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "无权切换",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "sid": []
          }
        ]
      }
    },
    "/auth/tenants": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "返回当前会话用户可切换的租户。",
        "operationId": "listTenants",
        "responses": {
          "200": {
            "description": "可访问租户列表",
