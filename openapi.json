    "/api/v1/feedbacks/{id}/generations": {
      "post": {
        "tags": [
          "generation"
        ],
        "summary": "生成单份反馈，以 SSE 发送 `delta` 与 `done` 事件。",
        "operationId": "generateFeedback",
