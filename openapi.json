            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "sid": []
          }
        ]
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "存活探针：只检查进程是否还能响应。",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "进程存活"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "就绪探针：检查双连接池与任务队列表。",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "依赖就绪"
          },
          "503": {
            "description": "数据库或队列表未就绪"
          }
        }
      }
    }
