{
  "name": "tech-system",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tanstack/react-query": "^5.105.0",
      "@tanstack/react-query-devtools": "^5.105.0",
      "@tanstack/react-router": "^1.170.46",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.2",
      "openapi-typescript": "^7.13.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "typescript": "^5.9.3",
      "vite": "^8.3.5",
      "vitest": "^5.0.5",
      "@tailwindcss/vite": "^4.3.3",
      "@testing-library/jest-dom": "^7.0.1",
      "@testing-library/react": "^16.3.3",
      "@testing-library/user-event": "^14.6.8",
      "class-variance-authority": "^0.7.1",
      "jsdom": "^30.1.3",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "radix-ui": "^1.8.1",
      "lucide-react": "^1.66.0",
      "cn": "^0.5.1",
      "@hookform/resolvers": "^7.0.0",
      "react-hook-form": "^7.91.0",
      "zod": "^4.6.7",
      "@types/node": "^24.19.2"
    }
  },
  "scripts": {
    "build": "bun run build:web && bun run build:admin",
    "build:web": "bun run --filter '@tech-system/web' build",
    "build:admin": "bun run --filter '@tech-system/admin' build",
    "test": "vitest run",
    "size": "bun run size:web && bun run size:admin",
    "size:web": "bun scripts/check-size.mjs",
    "size:admin": "bun scripts/check-size.mjs apps/admin/dist/.vite/manifest.json 512000 admin",
    "typecheck": "tsc -p apps/web && tsc -p apps/admin && tsc -p packages/ui && tsc -p packages/api-types",
    "generate:api": "bash scripts/generate-openapi.sh"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "jsdom": "catalog:"
  }
}
