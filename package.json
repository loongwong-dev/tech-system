{
  "name": "tech-system",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tanstack/react-query": "^5.105.0",
      "@tanstack/react-query-devtools": "^5.105.0",
      "@tanstack/react-router": "^1.170.46",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.2",
      "openapi-typescript": "^7.13.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "typescript": "^5.9.3",
      "vite": "^8.3.5",
      "vitest": "^5.0.5"
    }
  },
  "scripts": {
    "build": "bun run build:web && bun run build:admin",
    "build:web": "bun run --filter '@tech-system/web' build",
    "build:admin": "bun run --filter '@tech-system/admin' build",
    "test": "vitest run",
    "size": "bun run size:web && bun run size:admin",
    "size:web": "bun scripts/check-size.mjs",
    "size:admin": "bun scripts/check-size.mjs apps/admin/dist/.vite/manifest.json 512000 admin",
    "typecheck": "tsc -p apps/web && tsc -p apps/admin",
    "generate:api": "bash scripts/generate-openapi.sh"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
